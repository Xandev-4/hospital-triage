# ==============================================================================
# HM-Triage - .gitignore
# Stack: Node.js, Express, PostgreSQL (Neon), Prisma, JWT/bcrypt, Multer, dotenv
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/
.pnp
.pnp.js
.pnpm-store/

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (dotenv, Neon DB URLs, JWT secrets)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.test.example

# Private Keys & Certificates (JWT RS256/asymmetric keys, SSL certs)
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ------------------------------------------------------------------------------
# File Uploads & Temporary Media (Multer: Voice, OCR Images, Temp Buffers)
# ------------------------------------------------------------------------------
uploads/
!uploads/.gitkeep
tmp/
!tmp/.gitkeep
temp/
!temp/.gitkeep
storage/
!storage/.gitkeep

# Multer cache / OCR cache
.cache/
ocr-cache/

# ------------------------------------------------------------------------------
# Database & ORM (Prisma / PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# Local SQLite fallbacks / DB dumps
*.db
*.db-journal
*.sqlite
*.sqlite3
*.dump
*.sql.gz

# Prisma custom generated client (if configured outside node_modules)
# prisma/generated/

# ------------------------------------------------------------------------------
# Logs & Process Artifacts
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pids/
*.pid
*.seed
*.pid.lock

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ------------------------------------------------------------------------------
# Test & Coverage Artifacts
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov

# ------------------------------------------------------------------------------
# Build & Distribution Artifacts
# ------------------------------------------------------------------------------
dist/
build/
out/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# Operating System Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# IDE & Editor Configurations
# ------------------------------------------------------------------------------
# VS Code (preserve team configuration files if needed)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (IntelliJ, WebStorm, etc.)
.idea/

# Sublime Text & Vim
*.sublime-project
*.sublime-workspace
*.swp
*.swo
